# =====================================================================
#  FREE TESTING SETUP (default values below)
#  Every service here has a free tier. See README -> "Free testing setup".
# =====================================================================

# ---------- Server ----------
PORT=5000
NODE_ENV=production
# Long random string (run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# ---------- MongoDB Atlas (free M0 cluster) ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/chatly?retryWrites=true&w=majority

# ---------- OTP ----------
# log    = FREE testing: a real random 6-digit code is printed in the server logs/terminal
# twilio = real SMS (Twilio trial is free but only sends to numbers you verify in Twilio)
OTP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ---------- Cloudinary (free plan, media storage) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- AI Assistant (any OpenAI-compatible API) ----------
# AI_VISION: set "true" ONLY for vision-capable models (GPT-4o, Gemini).
# Leave "false" (or unset) for Groq llama models — they cannot read images and
# will fail every AI reply that contains a photo.
AI_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_VISION=false
AI_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# FREE option 2: Google Gemini (text + photos, smaller daily free limit) - https://aistudio.google.com/apikey
# AI_API_KEY=AIzaxxxxxxxxxxxxxxxx
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-3.8-flash
# AI_VISION=true
# AI_TRANSCRIBE_MODEL=

# PAID option: OpenAI (text + photos + voice)
# AI_API_KEY=sk-xxxxxxxx
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini
# AI_VISION=true
# AI_TRANSCRIBE_MODEL=whisper-1

AI_ASSISTANT_NAME=AI Assistant

# ---------- Optional: App Store / Play Store review login ----------
REVIEW_PHONE=
REVIEW_CODE=

# ---------- Agora voice & video calls ----------
# Same App ID as EXPO_PUBLIC_AGORA_APP_ID in the app (console.agora.io -> your project).
# AGORA_APP_CERTIFICATE: only if your Agora project uses "Secure mode" (App ID + Token).
#   Agora console -> Project -> Security -> Primary Certificate. Leave empty for "Testing mode".
#   If the certificate is enabled in Agora but missing here, calls connect but there is NO AUDIO.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Max upload size in MB (Cloudinary free plan: 10 MB images, 100 MB videos)
MAX_UPLOAD_MB=40
