# Copy to .env for local development.
# Use your computer's LAN IP when running the server locally (phone and PC on the same Wi-Fi),
# or your deployed Render URL. No trailing slash.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# Agora App ID for real voice/video calls (dev builds only - not needed in Expo Go).
# Get a free App ID at https://console.agora.io -> Create project -> Testing mode.
# EAS dev builds also need this in eas.json (env is baked at build time).
EXPO_PUBLIC_AGORA_APP_ID=
